rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin is now ONLY the Google account signed in via admin.html's Google Sign-In flow.
    // The old email/UID check is gone on purpose — that password was public for 6+ weeks
    // and is the likely breach vector; anyone who had it passed isAdmin() and hit the
    // catch-all rule at the bottom, giving them read/write on every collection.
    // admin.html requires two steps before it ever calls signInWithPopup: clicking a one-time
    // emailed link, then completing Google Sign-In. Requiring sign_in_provider == 'google.com'
    // here means that even if the email-link step alone ever left a session active due to a
    // client bug, it could not read/write anything admin-only — only a completed Google
    // sign-in counts at the data layer.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'reaganayiecho@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Accepts either `uid` or `userId` as the owner field, since different pages in the
    // codebase write different field names for the same purpose. Using .get(field, null)
    // instead of dot-access so a doc missing one of the two fields doesn't error out.
    function claimsOwnership() {
      return request.resource.data.get('uid', null) == request.auth.uid
        || request.resource.data.get('userId', null) == request.auth.uid;
    }
    function ownsExisting() {
      return resource.data.get('uid', null) == request.auth.uid
        || resource.data.get('userId', null) == request.auth.uid;
    }

    // Fields only admin may ever set. Blocks a user from granting themselves Pro,
    // raising their own limits, or un-banning themselves via a direct write.
    function touchesPrivilegedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['plan', 'betaLimit', 'customLimit', 'banned', 'planUpdatedAt', 'limitSetBy', 'limitSetAt']);
    }

    // Users can read/write their own profile — no public read, no self-granted privilege fields.
    match /studio_users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId
        // Every signup flow across the site writes plan:'beta' on account creation — that's
        // fine; only self-assigning 'pro'/'admin'/etc at signup, or the other privileged
        // fields, is blocked.
        && !request.resource.data.keys().hasAny(['betaLimit', 'customLimit', 'banned', 'planUpdatedAt', 'limitSetBy', 'limitSetAt'])
        && request.resource.data.get('plan', 'beta') == 'beta';
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == userId && !touchesPrivilegedFields());
      allow delete: if isAdmin();
    }

    // Videos
    match /studio_videos/{docId} {
      allow read, delete: if isAdmin() || (request.auth != null && ownsExisting());
      allow create: if request.auth != null && claimsOwnership();
      allow update: if isAdmin();
    }

    // Photos
    match /studio_photos/{docId} {
      allow read, delete: if isAdmin() || (request.auth != null && ownsExisting());
      allow create: if request.auth != null && claimsOwnership();
      allow update: if isAdmin();
    }

    // Designs
    match /studio_designs/{docId} {
      allow read, delete: if isAdmin() || (request.auth != null && ownsExisting());
      allow create: if request.auth != null && claimsOwnership();
      allow update: if isAdmin();
    }

    // Feedback - anyone can submit, but can't put someone else's uid on it
    match /feedback/{docId} {
      allow create: if request.resource.data.get('userId', 'anonymous') == 'anonymous'
        || (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow read, write: if isAdmin();
    }

    // Upgrade requests - anyone can submit (contains PII: name/email/phone/payment — admin-only read)
    match /upgrade_requests/{docId} {
      allow create: if request.resource.data.get('userId', 'anonymous') == 'anonymous'
        || (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow read, write: if isAdmin();
    }

    // AfriBrain data
    match /afribrain_data/{docId} {
      allow create: if request.auth != null;
      allow read, write: if isAdmin();
    }

    // Admin finances - admin only
    match /admin_transactions/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin settings - admin only
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // Announcements - all signed-in users read, admin writes
    match /announcements/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Public homepage stats — a single denormalized counter doc so the landing page can show
    // real totals without needing list/read access to studio_users or studio_videos (locked
    // down after the breach, see above). Anyone can read it. Writes are restricted to signed-in
    // users nudging exactly one counter up by exactly 1 per request, so a compromised or
    // malicious client can only inflate a vanity number, never read or corrupt anything else.
    match /public_stats/counts {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userCount'])
            && request.resource.data.userCount == resource.data.userCount + 1)
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videoCount'])
            && request.resource.data.videoCount == resource.data.videoCount + 1);
    }

    // Catch-all - admin can access everything else; everyone else denied by default
    match /{collection}/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
